gassocaccountid\" operator=\"eq\" value=\"{new_ptmaid}\" />\n          <condition attribute=\"new_provincenumber\" operator=\"eq\" value=\"{new_provincenumber}\" />\n        </filter>\n      </filter>\n<!--   removed Sprint 13\n      <filter type=\"or\" >\n        <condition attribute=\"lastname\" operator=\"eq\" value=\"{lastname}\" />\n        <condition attribute=\"new_physicianname\" operator=\"eq\" value=\"{firstname}\" />\n        <condition attribute=\"firstname\" operator=\"eq\" value=\"{firstname}\" />\n      </filter>\n-->\n      <!-- birtdate must match  -->\n      <condition attribute=\"birthdate\" operator=\"eq\" value=\"{birthdate}\" />\n    </filter>\n  </entity>\n</fetch>",
