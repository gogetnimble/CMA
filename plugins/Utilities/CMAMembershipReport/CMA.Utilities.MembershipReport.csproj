<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CMA.Utilities.MembershipReport</RootNamespace>
    <AssemblyName>CMA.Utilities.MembershipReport</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" Version="1.1.10" />
    <PackageReference Include="Newtonsoft.Json"                           Version="13.0.3" />
    <PackageReference Include="Spectre.Console"                           Version="0.49.1" />
  </ItemGroup>

  <!-- The HTML template ships next to the executable; the generator reads it,
       injects the dataset, and writes the final report. -->
  <ItemGroup>
    <None Update="Templates\report-template.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.sample.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
